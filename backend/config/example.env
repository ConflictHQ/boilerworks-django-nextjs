# ============================================================
# Boilerworks — Local Development Environment
#
# Copy this file to local.env and fill in your values.
# bootstrap.sh does this automatically on first run.
#
# DO NOT commit local.env — it is gitignored.
# ============================================================


# ------------------------------------------------------------
# Django Core                                        REQUIRED
# ------------------------------------------------------------

# Generate a new key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changeme-generate-a-long-random-secret-key-here

DJANGO_DEBUG=True
DJANGO_CONFIGURATION=Local

DJANGO_CORS_ALLOW_CREDENTIALS=True
DJANGO_CORS_ALLOW_ALL_ORIGINS=True


# ------------------------------------------------------------
# Database                                           REQUIRED
#
# When running via docker-compose these are overridden by the
# environment: section in docker-compose.yaml.
# These values are used when running Django outside Docker.
# ------------------------------------------------------------

POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=boilerworks
POSTGRES_USER=dbadmin
POSTGRES_PASSWORD=changeme-local-db-password


# ------------------------------------------------------------
# Cache                                              REQUIRED
#
# Overridden by docker-compose for container use.
# ------------------------------------------------------------

DJANGO_CACHE_URL=redis://localhost:6379/1


# ------------------------------------------------------------
# Google Cloud                                       OPTIONAL
#
# Leave blank to fall back to local filesystem storage.
# Set DJANGO_DEFAULT_FILE_STORAGE to use GCS for uploads.
# ------------------------------------------------------------

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_MAPS_API_KEY=
DJANGO_GOOGLE_API_KEY=
DJANGO_GS_CREDENTIALS=
DJANGO_GS_BUCKET_NAME=changeme-your-gcs-bucket-name
DJANGO_GS_DIR=dev

# Use this for local dev (no GCS bucket needed):
DJANGO_DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# Use this to enable GCS:
# DJANGO_DEFAULT_FILE_STORAGE=storages.backends.gcloud.GoogleCloudStorage


# ------------------------------------------------------------
# Auth0                                              OPTIONAL
# ------------------------------------------------------------

AUTH0_DOMAIN=changeme-your-tenant.us.auth0.com
AUTH0_CLIENT_ID=changeme-your-auth0-client-id
AUTH0_CLIENT_SECRET=changeme-your-auth0-client-secret
AUTH0_AUDIENCE=changeme-your-auth0-audience


# ------------------------------------------------------------
# Twilio                                             OPTIONAL
# ------------------------------------------------------------

TWILIO_ACCOUNT_SID=changeme-your-twilio-account-sid
TWILIO_AUTH_TOKEN=changeme-your-twilio-auth-token
TWILIO_FROM_NUMBER=+15550000000


# ------------------------------------------------------------
# AWS                                                OPTIONAL
# ------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1


# ------------------------------------------------------------
# Sentry                                             OPTIONAL
# Leave blank to disable error reporting.
# ------------------------------------------------------------

SENTRY_DSN=


# ------------------------------------------------------------
# Metabase                                           OPTIONAL
# ------------------------------------------------------------

METABASE_SITE_URL=
METABASE_SECRET_KEY=


# ------------------------------------------------------------
# OpenTelemetry                                      OPTIONAL
#
# Leave OTEL_EXPORTER_OTLP_ENDPOINT blank for local dev.
# Local dev uses ConsoleSpanExporter (stdout) when no endpoint
# is set. Non-local envs log a warning if this is unset.
# ------------------------------------------------------------

# Override the service name reported to your collector
OTEL_SERVICE_NAME=boilerworks

# gRPC/HTTP OTLP collector endpoint, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional headers for authenticated collectors
# e.g. Authorization=Bearer <token>
OTEL_EXPORTER_OTLP_HEADERS=
